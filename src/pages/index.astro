---
import "../styles/global.css"
import { Image } from "astro:assets";
import logo from "../assets/logo.png"
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Bymorphi</title>
	</head>
	<body>
		<main class="bg-background h-screen flex justify-center items-center p-5">
			<section class="flex flex-col justify-center items-center">
				<img src={logo.src} class="h-20 w-20 rounded-full"/>
				<h1 class="text-4xl text-primary font-heading font-semibold text-center mt-2">Welcome to Bymorphi!</h1>
				<p class="text-xs text-light font-normal text-center max-w-80 mt-4">Bymorphi services are coming soon; please bear with us for a little while.</p>
				<a href="https://wa.me/6285935391713" target="_blank" class="bg-accent h-10 px-4 rounded-full flex justify-center items-center text-sm font-semibold text-white mt-5 duration-150 hover:bg-primary hover:scale-110">Contact Us</a>
			</section>
		</main>
	</body>
</html>
