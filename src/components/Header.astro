---
import { Image } from "astro:assets";
import logo from "../assets/logo.png";

const links = [
	{ label: "Home", href: "#home" },
	{ label: "About", href: "#about" },
	{ label: "Portfolio", href: "#projects" },
	{ label: "Pricing", href: "#pricing" },
];
const contact = "https://wa.me/6285935391713";
---

<header class="sticky top-0 z-100 w-full bg-background/85 backdrop-blur">
	<div class="mx-auto flex h-[72px] max-w-6xl items-center justify-between px-5 md:grid md:h-24 md:grid-cols-[1fr_auto_1fr] md:px-8">
		<a
			href="#home"
			aria-label="Bymorphi, back to top"
			class="justify-self-start rounded-full focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
		>
			<Image src={logo} alt="" width={96} height={96} class="size-11 rounded-full object-cover md:size-12" />
		</a>

		<nav
			data-nav
			aria-label="Main"
			class="absolute inset-x-5 top-full mt-2 hidden flex-col rounded-3xl bg-primary p-2 shadow-[0_20px_40px_-20px_rgba(59,33,25,.6)] data-open:flex md:static md:mt-0 md:flex md:flex-row md:gap-1 md:rounded-full md:p-1.5 md:shadow-none"
		>
			{
				links.map((link) => (
					<a
						href={link.href}
						class="rounded-full px-5 py-3 text-base font-semibold text-background transition-colors duration-200 hover:bg-background/15 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-background md:py-2.5 md:text-sm"
					>
						{link.label}
					</a>
				))
			}
		</nav>

		<div class="flex items-center gap-2 justify-self-end">
			<a
				href={contact}
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex h-10 items-center rounded-full bg-accent px-5 text-sm font-bold text-primary transition-colors duration-200 hover:bg-primary hover:text-background focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary md:h-11 md:px-6"
			>
				Contact
			</a>
			<button
				type="button"
				data-menu-button
				aria-expanded="false"
				aria-label="Toggle menu"
				class="group grid size-10 place-items-center rounded-full bg-primary text-background focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary md:hidden"
			>
				<svg viewBox="0 0 24 24" class="size-5 group-aria-expanded:hidden" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
					<path d="M4 8h16M4 16h16"></path>
				</svg>
				<svg viewBox="0 0 24 24" class="hidden size-5 group-aria-expanded:block" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
					<path d="M6 6l12 12M18 6L6 18"></path>
				</svg>
			</button>
		</div>
	</div>
</header>

<script>
	const button = document.querySelector<HTMLButtonElement>("[data-menu-button]");
	const nav = document.querySelector<HTMLElement>("[data-nav]");

	if (button && nav) {
		const setOpen = (open: boolean) => {
			nav.toggleAttribute("data-open", open);
			button.setAttribute("aria-expanded", String(open));
		};

		button.addEventListener("click", () => setOpen(!nav.hasAttribute("data-open")));
		nav.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setOpen(false)));
		document.addEventListener("keydown", (e) => {
			if (e.key === "Escape") setOpen(false);
		});
	}
</script>
