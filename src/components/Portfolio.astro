---
import { projects } from "../data/projects";

const contact = "https://wa.me/6285935391713";

// Staggered editorial grid: wide and narrow items alternate, narrow ones sit lower.
const layout = [
	"md:col-span-7",
	"md:col-span-5 md:mt-24",
	"md:col-span-5",
	"md:col-span-7 md:mt-24",
];
---

<section id="projects" class="relative overflow-hidden">
	<div class="mx-auto max-w-6xl px-5 py-16 md:px-8 md:py-28">
		<div class="grid gap-5 md:grid-cols-12 md:items-end md:gap-x-10">
			<h2 class="font-heading text-3xl font-normal leading-[1.1] text-balance md:col-span-7 md:text-5xl">
				Fresh from the studio.
			</h2>
			<p class="max-w-sm text-base leading-relaxed text-soft md:col-span-5 md:text-lg">
				A few F&amp;B sites we have built, from morning coffee to late-night plates.
			</p>
		</div>

		<ul class="mt-12 grid list-none gap-14 p-0 md:mt-20 md:grid-cols-12 md:gap-x-10 md:gap-y-16">
			{
				projects.map((p, i) => (
					<li class={layout[i % layout.length]}>
						<a
							href={p.url}
							class="group block focus-visible:outline-3 focus-visible:outline-offset-8 focus-visible:outline-primary"
						>
							<div
								style={`background-color:${p.color}`}
								class:list={[
									"@container relative aspect-[4/3] overflow-hidden rounded-3xl text-white shadow-[0_24px_40px_-24px_rgba(59,33,25,.55)] transition duration-300 ease-out group-hover:-translate-y-2 group-hover:rotate-0 group-hover:shadow-[0_36px_60px_-28px_rgba(59,33,25,.6)]",
									i % 2 === 0 ? "-rotate-1" : "rotate-1",
								]}
							>
								{p.image ? (
									<img src={p.image} alt={`${p.name} website preview`} loading="lazy" class="size-full object-cover" />
								) : (
									<div aria-hidden="true" class="flex size-full flex-col">
										<div class="flex items-center justify-between px-[6cqw] pt-[5cqw]">
											<span class="font-serif text-[3.6cqw]">{p.name}</span>
											<span class="flex gap-[1.5cqw]">
												<i class="h-[0.9cqw] w-[5cqw] rounded-full bg-white/60" />
												<i class="h-[0.9cqw] w-[5cqw] rounded-full bg-white/60" />
												<i class="h-[0.9cqw] w-[5cqw] rounded-full bg-white/60" />
											</span>
										</div>
										<div class="flex flex-1 flex-col items-center justify-center px-[12cqw] pb-[6cqw] text-center">
											<p class="font-serif text-[8cqw] leading-[1.05]">{p.name}</p>
											<p class="mt-[3cqw] max-w-[60cqw] text-[3cqw] leading-snug text-white/80">{p.tagline}</p>
											<span class="mt-[4cqw] rounded-full bg-white px-[4cqw] py-[1.2cqw] text-[2.8cqw] font-bold" style={`color:${p.color}`}>
												Reserve
											</span>
										</div>
									</div>
								)}
							</div>

							<div class="mt-5 flex items-start justify-between gap-4">
								<div>
									<h3 class="font-heading text-xl font-normal md:text-2xl">{p.name}</h3>
									<p class="mt-1 text-base text-soft">{p.tagline}</p>
								</div>
								<span class="mt-1 shrink-0 rounded-full bg-beige px-3 py-1 text-sm font-semibold transition-colors duration-200 group-hover:bg-accent">
									{p.type}
								</span>
							</div>
							<span class="mt-3 inline-block border-b-2 border-accent pb-0.5 text-sm font-bold transition-[padding] duration-200 group-hover:pr-2">
								View project
							</span>
						</a>
					</li>
				))
			}
		</ul>

		<div class="mt-16 flex flex-col items-start gap-5 rounded-3xl bg-beige p-6 md:mt-28 md:flex-row md:items-center md:justify-between md:p-10">
			<p class="font-heading text-2xl font-normal leading-tight text-balance md:max-w-md md:text-3xl">
				Have a place in mind? Let&rsquo;s plan its website.
			</p>
			<a
				href={contact}
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex h-12 items-center rounded-full bg-accent px-8 text-base font-bold text-primary transition duration-200 hover:-translate-y-0.5 hover:bg-primary hover:text-background focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
			>
				Let&rsquo;s Build with Us
			</a>
		</div>
	</div>
</section>
